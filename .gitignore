# Version-control exclusions for the analysis archive.
#
# outputs/ is regenerated by 00_run_all.R and need not be committed, with the
# exception of the directory placeholders. Comment out the outputs/ lines if
# you want to ship the generated figures and tables as part of the archive.

# generated analysis artefacts
outputs/cache/
outputs/models/
outputs/figures/
outputs/tables/
outputs/session_info.*
outputs/*.txt

# keep the directory structure
!outputs/cache/.gitkeep
!outputs/figures/.gitkeep
!outputs/models/.gitkeep
!outputs/tables/.gitkeep

# the individual-cycle dataset is never distributed
data/*.xlsx
data/*.xls
data/*.csv
!data/README.md

# R session leftovers
.Rhistory
.RData
.Rproj.user/
*.Rproj

# smoke-test output (IVF_SMOKE=1) is never shipped
outputs_smoke/

# the model bundle is generated by 15_export_model_bundle.R
shiny/model_bundle.rds

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp

# credentials for shinyapps.io -- never commit these
rsconnect/
.httr-oauth
